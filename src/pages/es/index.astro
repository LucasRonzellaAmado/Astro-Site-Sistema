---
import { ui } from '../../utils/i18n.js';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import "../../styles/index.css";

const lang = 'es'; 
const t = ui[lang];
---

<Layout title="NexusFlow - Gestão Simples e Barata para seu Comércio">
	<Header lang={lang} />
	
	<main>
		<section class="hero">
			<div class="container-hero">
				<div class="hero-text" data-aos="fade-right">
					<span class="badge">{t.heroBadge}</span>
					<h1>{t.heroTitle}</h1>
					<p>{t.heroSub}</p>
					<div class="hero-btns">
						<a href="#" class="btn-primary">{t.btnDemo}</a>
					</div>
				</div>
				<div class="hero-image" data-aos="fade-left">
					<img src="/print-nexus.png" alt="Dashboard NexusFlow" />
				</div>
			</div>
		</section>

		<section class="stats" data-aos="fade-up">
			<div class="container-stats">
				<div class="stat-item">
					<h2>{t.statsTitle1}</h2>
					<p>{t.statsDesc1}</p>
				</div>
				<div class="stat-item">
					<h2>{t.statsTitle2}</h2>
					<p>{t.statsDesc2}</p>
				</div>
				<div class="stat-item">
					<h2>{t.statsTitle3}</h2>
					<p>{t.statsDesc3}</p>
				</div>
			</div>
		</section>

		<section class="pricing">
			<div class="container">
				<h2 class="section-title" data-aos="fade-up">{t.pricingTitle}</h2>
				<div class="pricing-grid">
					<div class="price-card" data-aos="fade-up" data-aos-delay="100">
						<h3>{t.meiTitle}</h3>
						<div class="price">{t.priceUnit} <span>49</span>,90{t.pricePeriod}</div>
						<ul>
							<li>✓ {t.featSales}</li>
							<li>✓ {t.featStock}</li>
							<li>✓ Suporte via WhatsApp</li>
						</ul>
						<a href="#" class="btn-primary">{t.btnStart}</a>
					</div>
					<div class="price-card featured" data-aos="fade-up" data-aos-delay="300">
						<div class="tag">Mais Vendido</div>
						<h3>{t.comercioTitle}</h3>
						<div class="price">{t.priceUnit} <span>89</span>,90{t.pricePeriod}</div>
						<ul>
							<li>✓ {t.featSales} & {t.featStock}</li>
							<li>✓ {t.featNfe}</li>
							<li>✓ Relatórios de Desempenho</li>
							<li>✓ {t.heroBadge}</li>
						</ul>
						<a href="#" class="btn-primary">{t.btnStart}</a>
					</div>
				</div>
			</div>
		</section>

		<section class="segments">
			<div class="container">
				<h2 class="section-title" data-aos="fade-up">Feito para o seu comércio</h2>
				<div class="segments-grid">
					<div class="segment-card" data-aos="flip-left"><span>👕</span><p>Lojas de Roupas</p></div>
					<div class="segment-card" data-aos="flip-left" data-aos-delay="100"><span>🍎</span><p>Hortifruti & Mercados</p></div>
					<div class="segment-card" data-aos="flip-left" data-aos-delay="200"><span>🔧</span><p>Materiais de Construção</p></div>
					<div class="segment-card" data-aos="flip-left" data-aos-delay="300"><span>🍔</span><p>Lanchonetes</p></div>
				</div>
			</div>
		</section>

		<section class="testimonials">
			<div class="container">
				<h2 class="section-title" data-aos="fade-up">{t.testimonyTitle}</h2>
				<div class="testimonial-grid">
					<div class="testimonial-card" data-aos="fade-right">
						<p>"O NexusFlow mudou a forma como controlo meu estoque. É simples e o suporte do Lucas é sensacional."</p>
						<div class="client-info"><strong>Ricardo Silva</strong><span>Dono de Hortifruti</span></div>
					</div>
				</div>
			</div>
		</section>

		<section class="faq">
			<div class="container">
				<h2 class="section-title" data-aos="fade-up">{t.faqTitle}</h2>
				<div class="faq-grid">
					<div class="faq-item" data-aos="fade-up">
						<h4>{t.faqQ1}</h4>
						<p>{t.faqA1}</p>
					</div>
					<div class="faq-item" data-aos="fade-up" data-aos-delay="100">
						<h4>{t.faqQ2}</h4>
						<p>{t.faqA2}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="final-cta" data-aos="zoom-in">
			<div class="container-cta">
				<h2>{t.finalCtaTitle}</h2>
				<p>{t.finalCtaSub}</p>
				<div class="cta-buttons">
					<a href="#" class="btn-primary">{t.btnTest}</a>
					<a href="https://wa.me/5519988887777" class="btn-secondary">{t.btnDev}</a>
				</div>
			</div>
		</section>
	</main>

	<Footer lang={lang} />
</Layout>
