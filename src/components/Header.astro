---
const links = [
	{ href: '/solucoes', label: 'Soluções' },
	{ href: '/#solucao', label: 'Para quem' },
	{ href: '/#pdv', label: 'PDV' },
	{ href: '/#modulos', label: 'Módulos' },
	{ href: '/#seguranca', label: 'Segurança' },
	{ href: '/#investimento', label: 'Investimento' },
	{ href: '/#faq', label: 'Dúvidas' },
];
const demoLink = 'https://wa.me/5519993724653?text=Ol%C3%A1%21%20Quero%20agendar%20uma%20demonstra%C3%A7%C3%A3o%20do%20NexusFlow.';
---
<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="logo" aria-label="NexusFlow — página inicial">
			<span class="logo-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
					<path d="M12 4A8 8 0 0 1 19.52 14.74" />
					<path d="M18.93 16A8 8 0 0 1 5.87 17.14" />
					<path d="M5.07 16A8 8 0 0 1 10.61 4.12" />
				</svg>
			</span>
			<span>Nexus<span>Flow</span></span>
		</a>

		<nav class="main-nav" aria-label="Principal">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>

		<div class="header-cta">
			<a href={demoLink} class="btn btn-primary" target="_blank" rel="noopener">Agendar demonstração</a>
		</div>

		<details class="menu-toggle">
			<summary aria-label="Abrir menu"><i class="bi bi-list"></i></summary>
		</details>
	</div>
	<div class="mobile-panel">
		{links.map((l) => <a href={l.href}>{l.label}</a>)}
		<a href={demoLink} class="btn btn-primary btn-block" style="margin-top:12px;border-bottom:none" target="_blank" rel="noopener">Agendar demonstração</a>
	</div>
</header>
